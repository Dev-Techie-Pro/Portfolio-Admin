NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: secret for /api/cron/purge-activities and /api/cron/prune-sessions
CRON_SECRET=

# Optional: days to retain ended user_sessions (default 90)

SESSION_PRUNE_KEEP_DAYS=90

# Performance rollbacks (defaults: batch writes on, scoped media reconcile on)
# CMS_BATCH_WRITES=false
# MEDIA_FULL_RECONCILE=true

# SMTP — used for contact inbox replies and new-user credential emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_gmail_address

# Optional reply-email branding
EMAIL_BRAND_NAME=Muhammad Sohaib
EMAIL_BRAND_ROLE=Full Stack Web Developer
EMAIL_PORTFOLIO_LABEL=Portfolio Dashboard
EMAIL_PORTFOLIO_URL=https://sohaibishaque.com
EMAIL_GITHUB_URL=https://github.com/
EMAIL_LINKEDIN_URL=https://www.linkedin.com/
